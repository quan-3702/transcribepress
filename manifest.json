{
  "name": "TranscribePress - Audio & Video to Text",
  "short_name": "TranscribePress",
  "description": "Turn recordings, interviews, meetings, lectures and podcasts into text with AI that runs on your own computer. Speakers, Word, PDF and subtitle export. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f766e",
  "theme_color": "#0f766e",
